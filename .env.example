# 复制为 .env.local 并填真实值。后端 `travel-assistant-mcp-server`。

# ---- SerpAPI（必备：机票/酒店/活动/汇率） ----
SERPAPI_KEY=your_serpapi_key_here

# ---- LLM（可选：AI 解读 / 行程润色 / 智能对话助手；不配则走规则文案） ----
# 兼容 OpenAI 接口；默认 DeepSeek。填了 LLM_API_KEY 才启用 LLM 相关能力。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=20000

# ---- Vercel KV（可选：detail/filter 工具 + 缓存/限流后端） ----
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

# ---- 缓存 TTL（秒，夹到 [1h,24h]，默认 3600） ----
CACHE_TTL_SECONDS=3600

# ---- 免费每日限流（昂贵工具次数，默认 2） ----
FREE_DAILY_LIMIT=2

# ============================================================
# 微信登录 + 微信支付（真实联调；不配则走 mock）
# ============================================================

# 小程序 appid + 登录 secret（在微信公众平台「开发→开发设置」查看）
WECHAT_APPID=wx_xxxx
WECHAT_CODE2SESSION_SECRET=xxxx

# 微信支付商家号（商户平台）
WECHAT_MCHID=16xxxx

# 商户 API 证书序列号（微信支付「API安全」页）
WECHAT_PAY_SERIAL_NO=xxxx

# APIv3 密钥（32 位，支付平台设置）
WECHAT_PAY_API_V3_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 商户私钥（apiclient_key.pem 内容，或填该 PEM 文件路径）
WECHAT_PAY_MCH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# 支付结果通知回调地址（必须公网可达，配到小程序支付回调）
WECHAT_PAY_NOTIFY_URL=https://<your-project>.vercel.app/api/pay
